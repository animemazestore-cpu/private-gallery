# Copy to .env.local for local development. Never commit the real .env.local.
# See docs/ENVIRONMENT.md and docs/DEPLOYMENT.md for rules.

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-Only Configurations (Keep private!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-private-service-role-key

# Visitor Access PIN Hash (generate using: node scripts/hash-pin.js <pin>)
# For local dev fallback, a plain string (e.g. 1234) can be used.
VISITOR_PIN_HASH=1234

# Admin Authentication Secret (used for password and signing session cookies)
ADMIN_AUTH_SECRET=admin-dashboard-secret-at-least-32-chars-long
